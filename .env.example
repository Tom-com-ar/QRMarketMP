# Access Token de prueba de la aplicación Mercado Pago (solo backend)
MP_ACCESS_TOKEN=TEST-PEGAR_TOKEN_DE_PRUEBA
MP_ENVIRONMENT=sandbox

# Dejar vacío durante desarrollo local. En despliegue, usar URL pública HTTPS.
FRONTEND_URL=
PUBLIC_BASE_URL=
